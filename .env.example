# Every setting is env-driven; the commented lines show the built-in default. On k8s these
# are set in k8s/deployment.yaml, not here.

# Which backend runs the code. The HTTP API is identical either way.
#   gvisor — docker CLI on this host (local/EC2)
#   k8s    — one pod per session on Kubernetes (production)
SANDBOX_PROVIDER=gvisor

# Shared bearer token the backend/agent must send (Authorization: Bearer <token>).
# Leave empty to disable auth — DEV ONLY.
LLM_SANDBOX_TOKEN=change-me

# Runtime image untrusted code executes in (build from sandbox.Dockerfile).
# On k8s this must be a registry ref the sandbox node can pull, with an IMMUTABLE tag:
# session pods use imagePullPolicy IfNotPresent, so a moving tag goes stale on warm nodes.
SANDBOX_IMAGE=llm-sandbox-runtime:latest

# --- gvisor (docker) provider ---
# gVisor in prod. Set to "runc" on a machine WITHOUT gVisor to test plumbing locally
# (runc is NOT a security boundary — never use it for untrusted code in prod).
SANDBOX_DOCKER_RUNTIME=runc

# --- k8s provider ---
# Defaults match the target cluster's gVisor setup; shown here for reference.
# SANDBOX_K8S_NAMESPACE=            # empty = the service's own namespace
# SANDBOX_K8S_RUNTIME_CLASS=gvisor
# SANDBOX_K8S_NODE_SELECTOR=kops.k8s.io/instancegroup=ai-sandbox
# SANDBOX_K8S_TOLERATION=dedicated=ai-sandbox:NoSchedule
# SANDBOX_K8S_CREATE_TIMEOUT=120    # seconds to wait for a session pod to become Ready
# SANDBOX_K8S_IMAGE_PULL_SECRETS=   # "name[,name]" if SANDBOX_IMAGE is in a private registry
# SANDBOX_K8S_REAP_INTERVAL=120     # seconds between sweeps for finished session pods
# Sessions run on the cluster's DEFAULT runtime (runc) when RUNTIME_CLASS is empty — i.e.
# untrusted code with no isolation boundary. The service refuses to start in that state
# unless you say so here.
# SANDBOX_K8S_ALLOW_NO_RUNTIME_CLASS=0

# --- limits ---
# Hard cap on any single stdout/stderr/file payload returned to the caller.
SANDBOX_MAX_OUTPUT_BYTES=1000000

# Ceilings on what one caller may request per session. These are attacker-controlled request
# fields, so requests above the cap are clamped, not rejected.
# SANDBOX_MAX_MEMORY_MB=4096
# SANDBOX_MAX_CPUS=2

# In-flight backend operations across all sessions (backpressure on the docker daemon /
# apiserver).
# SANDBOX_MAX_CONCURRENCY=32

# Ceilings on caller-supplied timeouts (clamped, not rejected). A session past its timeout is
# reaped; an exec past its timeout is killed. Both hold real resources for their whole span.
# SANDBOX_MAX_SESSION_SECONDS=3600
# SANDBOX_MAX_EXEC_SECONDS=600

# HTTP request body cap (413 above it). Bounds every file/code payload — the body is read whole
# into memory before validation, so this is what keeps a single request from OOMing the pod.
# SANDBOX_MAX_REQUEST_BYTES=33554432

# Serve the unauthenticated /docs, /redoc, /openapi.json pages. Dev only.
# SANDBOX_EXPOSE_DOCS=0

# Live sessions this replica will hold before answering 429 (0 = unlimited). Bounds how
# MANY sandboxes exist; SANDBOX_MAX_MEMORY_MB / SANDBOX_MAX_CPUS bound how big each is.
# Per-replica: N replicas ⇒ N × this, which must stay under the namespace ResourceQuota.
# SANDBOX_MAX_SESSIONS=24

# Log command/code bodies. Default on for local debugging; k8s/deployment.yaml sets it to 0
# because those bodies are untrusted LLM output and may carry customer data into log retention.
# SANDBOX_LOG_PAYLOADS=1
